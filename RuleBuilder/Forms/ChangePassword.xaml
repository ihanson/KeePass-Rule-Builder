<Window
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	mc:Ignorable="d"
	x:Class="RuleBuilder.Forms.ChangePassword"
	Title="{DynamicResource ChangePassword}" WindowStartupLocation="CenterOwner"
	Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
	Width="600" MinWidth="400" SizeToContent="Height"
	FontSize="14px"
	Loaded="WindowLoaded" Closing="WindowClosing"
	Deactivated="WindowDeactivated"
>
	<Window.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary Source="../Resources/Styles.xaml"/>
				<ResourceDictionary Source="../Resources/Strings.xaml"/>
			</ResourceDictionary.MergedDictionaries>
		</ResourceDictionary>
	</Window.Resources>
	<Grid Margin="12">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>
		<Grid Grid.Row="0" Margin="0,0,0,12">
			<Grid.ColumnDefinitions>
				<ColumnDefinition/>
				<ColumnDefinition/>
			</Grid.ColumnDefinitions>
			<Grid VerticalAlignment="Top" Grid.ColumnSpan="2">
				<Grid.RowDefinitions>
					<RowDefinition/>
					<RowDefinition/>
					<RowDefinition/>
					<RowDefinition/>
					<RowDefinition/>
				</Grid.RowDefinitions>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="Auto"/>
					<ColumnDefinition/>
					<ColumnDefinition Width="Auto"/>
					<ColumnDefinition Width="Auto"/>
				</Grid.ColumnDefinitions>
				<WrapPanel Grid.Row="0" Grid.Column="0">
					<TextBlock Text="{DynamicResource OldPassword}" VerticalAlignment="Center"/>
					<TextBlock Text=":" Margin="0,0,8,0"/>
				</WrapPanel>
				<TextBox Name="txtOldPassword" Style="{DynamicResource PasswordEntry}" IsReadOnly="True" Grid.Column="1" Grid.ColumnSpan="2" Padding="2" Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}" />
				<Button Grid.Column="3" Grid.Row="0" Style="{DynamicResource IconButton}" ToolTip="{DynamicResource CopyPassword}" Click="CopyOldPassword">
					<Image Source="../Resources/Copy.png"/>
				</Button>
				<WrapPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,0,0,12">
					<WrapPanel Name="pnlAutoTypeOld">
						<TextBlock Text="{DynamicResource AutoType}" FontSize="12"/>
						<TextBlock Text=": " FontSize="12"/>
						<TextBlock Name="lblAutoTypeOld" MinWidth="16" FontSize="12"/>
						<Button Name="btnConfOldPassword" ToolTip="{DynamicResource ConfigureShortcut}" Click="ConfOldHotkeyClicked" Margin="4,0,0,0" Padding="2" BorderBrush="{x:Null}" Background="{x:Null}" VerticalAlignment="Bottom">
							<Image Source="../Resources/Gear.png" Height="12" Width="12" Opacity="0.4"/>
						</Button>
					</WrapPanel>
				</WrapPanel>
				<WrapPanel Grid.Row="2" Grid.Column="0">
					<TextBlock Text="{DynamicResource NewPassword}" VerticalAlignment="Center"/>
					<TextBlock Text=":" Margin="0,0,8,0"/>
				</WrapPanel>
				<TextBox Name="txtNewPassword" Style="{DynamicResource PasswordEntry}"  Grid.Column="1" Grid.Row="2" VerticalAlignment="Center" Padding="2" TextChanged="NewPasswordChanged"/>
				<Button Grid.Column="2" Grid.Row="2" Style="{DynamicResource IconButton}" ToolTip="{DynamicResource GenerateAnother}" Click="RefreshClicked">
					<Image Source="../Resources/Die.png" RenderTransformOrigin="0.5,0.5">
						<Image.RenderTransform>
							<RotateTransform Angle="5"/>
						</Image.RenderTransform>
					</Image>
				</Button>
				<Button Grid.Column="3" Grid.Row="2" Style="{DynamicResource IconButton}" ToolTip="{DynamicResource CopyPassword}" Click="CopyNewPassword">
					<Image Source="../Resources/Copy.png"/>
				</Button>
				<WrapPanel Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,0,0,12">
					<TextBlock Name="lblAutoTypeDisabled" FontSize="12" Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"/>
					<WrapPanel Name="pnlAutoTypeNew">
						<TextBlock Text="{DynamicResource AutoType}" FontSize="12"/>
						<TextBlock Text=": " FontSize="12"/>
						<TextBlock Name="lblAutoTypeNew" MinWidth="16" FontSize="12"/>
						<Button Name="btnConfNewPassword" ToolTip="{DynamicResource ConfigureShortcut}" Click="ConfNewHotkeyClicked" Margin="4,0,0,0" Padding="2" BorderBrush="{x:Null}" Background="{x:Null}" VerticalAlignment="Bottom">
							<Image Source="../Resources/Gear.png" Height="12" Width="12" Opacity="0.4"/>
						</Button>
					</WrapPanel>
				</WrapPanel>
				<WrapPanel Grid.Row="4" Grid.ColumnSpan="3">
					<CheckBox Name="chkExpiration" VerticalContentAlignment="Center" Click="ExpirationClicked">
						<WrapPanel VerticalAlignment="Center">
							<TextBlock Text="{DynamicResource PasswordExpires}" FontSize="14" VerticalAlignment="Center"/>
							<TextBlock Text=" " VerticalAlignment="Center"/>
							<DatePicker Name="dateExpiration" SelectedDateChanged="ExpirationDateChanged" IsTodayHighlighted="True" MaxWidth="150" Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" FontSize="12" Padding="2,2,0,2"/>
						</WrapPanel>
					</CheckBox>
				</WrapPanel>
			</Grid>
		</Grid>
		<Grid Grid.Row="2">
			<Grid.ColumnDefinitions>
				<ColumnDefinition/>
				<ColumnDefinition Width="Auto"/>
			</Grid.ColumnDefinitions>
			<Button Content="{DynamicResource EditRuleButton}" Click="EditRuleClicked" HorizontalAlignment="Left"/>
			<WrapPanel Grid.Column="1">
				<Button Content="{DynamicResource SaveNewPassword}" Click="SaveClicked" IsDefault="True"/>
				<Button Content="{DynamicResource Discard}" Margin="8,0,0,0" IsCancel="True"/>
			</WrapPanel>
		</Grid>
	</Grid>
</Window>
