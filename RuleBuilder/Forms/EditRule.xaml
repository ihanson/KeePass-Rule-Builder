<Window
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:util="clr-namespace:RuleBuilder.Util"
	mc:Ignorable="d"
	x:Class="RuleBuilder.Forms.EditRule"
	x:Name="Root"
	Title="{DynamicResource EditRule}" WindowStartupLocation="CenterOwner"
	Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
	Width="460" Height="460" MinWidth="360" MinHeight="360"
	FontSize="14"
	Closing="FormClosing"
>
	<Window.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary Source="../Resources/Styles.xaml"/>
				<ResourceDictionary Source="../Resources/Strings.xaml"/>
			</ResourceDictionary.MergedDictionaries>
		</ResourceDictionary>
	</Window.Resources>
	<Grid Margin="12">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>
		<WrapPanel Grid.Row="0" Margin="0,-2,0,-2">
			<RadioButton GroupName="RuleType" Name="rdoRule" Content="{DynamicResource Rule}" Padding="0,2,16,2" VerticalContentAlignment="Center" Checked="RuleOrProfileChecked"/>
			<RadioButton GroupName="RuleType" Name="rdoProfile" Content="{DynamicResource Profile}" Padding="0,2,16,2" VerticalContentAlignment="Center" Checked="RuleOrProfileChecked"/>
		</WrapPanel>
		<ListBox Grid.Row="1" Margin="0,12,0,0" Name="lbProfiles" SelectedIndex="{Binding SelectedProfileIndex}" ItemsSource="{Binding Profiles}" DisplayMemberPath="Name"/>
		<Grid Grid.Row="1" Margin="0,12,0,0" Name="gridRule">
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto"/>
				<RowDefinition/>
				<RowDefinition Height="Auto"/>
			</Grid.RowDefinitions>
			<Grid Grid.Row="0">
				<Grid.ColumnDefinitions>
					<ColumnDefinition/>
					<ColumnDefinition Width="Auto"/>
				</Grid.ColumnDefinitions>
				<WrapPanel Grid.Column="0">
					<TextBlock Text="{DynamicResource Length}"/>
					<TextBlock Text=":" Margin="0,0,8,0"/>
					<TextBox Width="50" MaxLength="3">
						<TextBox.Text>
							<Binding Path="PasswordRule.Length" UpdateSourceTrigger="PropertyChanged">
								<Binding.ValidationRules>
									<util:IntegerRangeRule Min="1" Max="100"/>
								</Binding.ValidationRules>
							</Binding>
						</TextBox.Text>
					</TextBox>
				</WrapPanel>
				<Button Grid.Column="1" Name="btnDeleteRow" Content="{DynamicResource DeleteRow}" Click="DeleteRowClicked" IsEnabled="False"/>
			</Grid>
			<DataGrid Grid.Row="1" Margin="0,12,0,0" ItemsSource="{Binding PasswordRule.Components}" HeadersVisibility="Column" AutoGenerateColumns="False" Name="dgComponents" SelectionMode="Single" SelectedCellsChanged="SelectedCellsChanged" CanUserAddRows="False" CanUserDeleteRows="False" MinRowHeight="25">
				<DataGrid.Resources>
					<util:ComponentTemplateSelector x:Key="CharacterTemplateSelector">
						<util:ComponentTemplateSelector.CharacterClassCell>
							<DataTemplate>
								<TextBlock Text="{Binding CharacterClass.Name}" VerticalAlignment="Center"/>
							</DataTemplate>
						</util:ComponentTemplateSelector.CharacterClassCell>
						<util:ComponentTemplateSelector.CustomCharacterCell>
							<DataTemplate>
								<TextBox Style="{DynamicResource PasswordEntry}" Text="{Binding CharacterClass.Characters, UpdateSourceTrigger=PropertyChanged}" BorderThickness="0" VerticalContentAlignment="Center" Loaded="TextBoxLoaded" TextChanged="CustomCharacterSetChanged"/>
							</DataTemplate>
						</util:ComponentTemplateSelector.CustomCharacterCell>
						<util:ComponentTemplateSelector.BlankCell>
							<DataTemplate>
								<Button Content="{DynamicResource AddCharacterSet}" Click="AddRowClicked"/>
							</DataTemplate>
						</util:ComponentTemplateSelector.BlankCell>
					</util:ComponentTemplateSelector>
					<util:ComponentTemplateSelector x:Key="RequiredTemplateSelector">
						<util:ComponentTemplateSelector.CharacterClassCell>
							<DataTemplate>
								<CheckBox IsChecked="{Binding Required, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" VerticalAlignment="Center" Click="GeneratePasswordClicked"/>
							</DataTemplate>
						</util:ComponentTemplateSelector.CharacterClassCell>
						<util:ComponentTemplateSelector.BlankCell>
							<DataTemplate/>
						</util:ComponentTemplateSelector.BlankCell>
					</util:ComponentTemplateSelector>
				</DataGrid.Resources>
				<DataGrid.Columns>
					<DataGridTemplateColumn CellTemplateSelector="{StaticResource CharacterTemplateSelector}" Width="*">
						<DataGridTemplateColumn.Header>
							<TextBlock Text="{DynamicResource Characters}"/>
						</DataGridTemplateColumn.Header>
					</DataGridTemplateColumn>
					<DataGridTemplateColumn CellTemplateSelector="{StaticResource RequiredTemplateSelector}" MinWidth="75">
						<DataGridTemplateColumn.Header>
							<TextBlock Text="{DynamicResource Required}"/>
						</DataGridTemplateColumn.Header>
					</DataGridTemplateColumn>
				</DataGrid.Columns>
			</DataGrid>
			<Grid Grid.Row="2" Margin="0,12,0,0">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="Auto"/>
					<ColumnDefinition/>
				</Grid.ColumnDefinitions>
				<WrapPanel Grid.Column="0">
					<TextBlock Text="{DynamicResource Exclude}"/>
					<TextBlock Text=":" Margin="0,0,8,0"/>
				</WrapPanel>
				<TextBox Grid.Column="1" Style="{DynamicResource PasswordEntry}" Text="{Binding PasswordRule.ExcludeCharacters, UpdateSourceTrigger=PropertyChanged}"/>
			</Grid>
		</Grid>
		<Grid Grid.Row="2" Margin="0,12,0,0">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="Auto"/>
				<ColumnDefinition/>
				<ColumnDefinition Width="Auto"/>
			</Grid.ColumnDefinitions>
			<WrapPanel Grid.Column="0">
				<TextBlock Text="{DynamicResource Example}"/>
				<TextBlock Text=":" Margin="0,0,8,0"/>
			</WrapPanel>
			<TextBox Grid.Column="1" Name="txtExample" Style="{DynamicResource PasswordEntry}"  IsReadOnly="True" Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"/>
			<Button Grid.Column="2" Grid.Row="2" Style="{DynamicResource IconButton}" ToolTip="{DynamicResource GenerateAnother}" Click="GeneratePasswordClicked">
				<Image Source="../Resources/Die.png" RenderTransformOrigin="0.5,0.5">
					<Image.RenderTransform>
						<RotateTransform Angle="5"/>
					</Image.RenderTransform>
				</Image>
			</Button>
		</Grid>
		<WrapPanel Grid.Row="3" Margin="0,12,0,0">
			<CheckBox IsChecked="{Binding PasswordExpires}" VerticalContentAlignment="Center">
				<WrapPanel IsEnabled="{Binding PasswordExpires}">
					<TextBlock Text="{DynamicResource Expiration}" VerticalAlignment="Center" Margin="0,0,8,0"/>
					<TextBox Width="50" MaxLength="3" Margin="0,0,8,0">
						<TextBox.Text>
							<Binding Path="ExpirationLength">
								<Binding.ValidationRules>
									<util:IntegerRangeRule Min="1" Max="999"/>
								</Binding.ValidationRules>
							</Binding>
						</TextBox.Text>
					</TextBox>
					<ComboBox SelectedIndex="{Binding ExpirationUnit}">
						<ComboBoxItem Content="{DynamicResource Days}"/>
						<ComboBoxItem Content="{DynamicResource Weeks}"/>
						<ComboBoxItem Content="{DynamicResource Months}"/>
						<ComboBoxItem Content="{DynamicResource Years}"/>
					</ComboBox>
				</WrapPanel>
			</CheckBox>
		</WrapPanel>
		<Grid Grid.Row="4" Margin="0,12,0,0">
			<Grid.ColumnDefinitions>
				<ColumnDefinition/>
				<ColumnDefinition Width="Auto"/>
			</Grid.ColumnDefinitions>
			<WrapPanel Grid.Column="0" Name="panelStrength" VerticalAlignment="Bottom" Visibility="Hidden">
				<TextBlock Text="{DynamicResource Strength}" FontSize="12"/>
				<TextBlock Text=": " FontSize="12"/>
				<TextBlock Name="txtStrength" FontSize="12"/>
			</WrapPanel>
			<WrapPanel Grid.Column="1">
				<Button Content="{DynamicResource Accept}" IsDefault="True" Click="AcceptClicked"/>
				<Button Content="{DynamicResource Cancel}" Margin="8,0,0,0" IsCancel="True"/>
			</WrapPanel>
		</Grid>
	</Grid>
</Window>